# Configurações Gerais
APP_NAME=MedChain FastAPI Service
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=True

# Autenticação JWT
JWT_SECRET=your-very-secure-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_SECONDS=3600
SECRET_KEY=your-very-secure-secret-key-change-this-in-production-min-32-chars

# Domínio
DOMAIN=localhost:8000
FRONTEND_URL=http://localhost:3000

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://postgres:senha_segura_aqui@postgres:5432/medchain_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha_segura_aqui
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_ENVIRONMENT_SUFFIX=
SQLALCHEMY_DATABASE_URI=

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# AWS S3
MEDICAL_RECORDS_API_AMAZON_S3_ACCESS_KEY_ID=seu_access_key_id
MEDICAL_RECORDS_API_AMAZON_S3_SECRET_ACCESS_KEY=seu_secret_access_key
MEDICAL_RECORDS_API_AMAZON_S3_MEDICAL_RECORD_FILES_BUCKET_ID=seu_bucket_id
MEDICAL_RECORDS_API_CRYPTO_KEY=sua_chave_de_criptografia_base64_aqui

# Solana Blockchain
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_PATH=solana_wallet.json


# Configurações de E-mail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=your-email@gmail.com

# Workspace
WORKSPACE=/caminho/para/seu/workspace